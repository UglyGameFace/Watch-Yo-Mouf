# Set in Watch Yo Mouf's separate Discloud app; never commit real credentials.
WATCH_YO_MOUF_TOKEN=
# One-time command registration only, then set back to false.
WATCH_YO_MOUF_SYNC_COMMANDS=false
# Optional later, for manual multi-process shard partitioning; keep unset on initial install.
# WATCH_YO_MOUF_SHARD_COUNT=4
# WATCH_YO_MOUF_SHARD_IDS=0,1

# Optional PRIVATE Discloud VLAN diagnostic. Must match Dank Shield's separate
# DANK_VOICE_BRIDGE_SECRET (32+ random characters), set only after both PRs deploy.
# This is NOT voice moderation, does not imply consent, and stays off by default.
WATCH_YO_MOUF_BRIDGE_ENABLED=false
WATCH_YO_MOUF_BRIDGE_SECRET=

# Optional private, synthetic-only model check (never authorizes voice capture).
# Match RIVAL_LLM_VOICE_TOKEN on the RivaL-Intelligence Discloud app; do not
# reuse RIVAL_LLM_SHARED_TOKEN, the Discord token or the Dank bridge secret.
WATCH_YO_MOUF_LLM_VOICE_ENABLED=false
WATCH_YO_MOUF_LLM_VOICE_TOKEN=

# OFF by default. Watch is an isolated STT worker, not a second Discord receiver.
# Mirror DANK_WATCH_AUDIO_SECRET on Dank Shield, using a DIFFERENT key from
# RivaL research, RivaL moderation, bot and private-status bridge tokens.
WATCH_YO_MOUF_STT_ENABLED=false
WATCH_YO_MOUF_AUDIO_SECRET=
# Optional local unpacked Vosk model directory. Leave empty for Vosk's official
# en-us model selector/cache (~40MB model download on first initialization).
WATCH_YO_MOUF_STT_MODEL_PATH=
